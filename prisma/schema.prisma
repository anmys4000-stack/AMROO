// المرحلة الأولى: المدارس والمستخدمون والأدوار.
// مبدأ عام: كل سجل تابع لمدرسة (schoolId) لعزل بيانات كل مدرسة عن غيرها.
// البيانات الشخصية محدودة بما يلزم فقط (تقليل البيانات)، ولا تُخزَّن كلمات المرور إلا مُجزّأة.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PRINCIPAL // مدير المدرسة
  STUDENT_AFFAIRS // وكيل شؤون الطلاب
  GUIDANCE // الموجّه الطلابي
  ACADEMIC_DEPUTY // وكيل الشؤون التعليمية
  TEACHER // المعلم
  GUARDIAN // ولي الأمر
}

model School {
  id        String        @id @default(cuid())
  name      String
  createdAt DateTime      @default(now())
  users     User[]
  classes   SchoolClass[]
  students  Student[]
}

model User {
  id                 String    @id @default(cuid())
  schoolId           String
  school             School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email              String    @unique
  fullName           String
  passwordHash       String
  role               Role
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  phone              String?
  specialty          String?
  createdAt          DateTime  @default(now())
  lastLoginAt        DateTime?

  @@index([schoolId])
}

// سجل التدقيق: من فعل ماذا ومتى، لحماية البيانات الشخصية وتتبّع الوصول.
model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  actorId   String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
}

// المرحلة الثانية: الفصول والطلاب والمواظبة والسلوك والجدول.
// كل جدول يحمل schoolId لعزل البيانات. بيانات الطالب محدودة بما يلزم فقط.

model SchoolClass {
  id       String           @id @default(cuid())
  schoolId String
  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String // مثال: أول ثانوي / 1
  students Student[]
  periods  TimetableEntry[]

  @@unique([schoolId, name])
}

model Student {
  id            String           @id @default(cuid())
  schoolId      String
  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId       String?
  schoolClass   SchoolClass?     @relation(fields: [classId], references: [id], onDelete: SetNull)
  fullName      String
  nationalRef   String? // مرجع داخلي اختياري، لا يُخزَّن رقم الهوية الوطنية
  guardianId    String? // ولي الأمر (مستخدم بدور GUARDIAN)
  guardianName  String?
  guardianPhone String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  attendance    Attendance[]
  behaviors     BehaviorRecord[]
  excuses       Excuse[]
  messages      Message[]
  referrals     Referral[]

  @@index([schoolId])
}

model Attendance {
  id         String           @id @default(cuid())
  schoolId   String
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  recordedBy String?
  createdAt  DateTime         @default(now())

  @@unique([studentId, date])
  @@index([schoolId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model BehaviorRecord {
  id          String   @id @default(cuid())
  schoolId    String
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category    String // مخالفة / سلوك إيجابي / إجراء تربوي
  description String
  recordedBy  String?
  createdAt   DateTime @default(now())

  @@index([schoolId, studentId])
}

model TimetableEntry {
  id          String      @id @default(cuid())
  schoolId    String
  classId     String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId   String? // مستخدم بدور TEACHER
  teacherName String? // اسم المعلم عندما لا يملك حسابًا بعد
  subject     String
  weekday     Int // 1 = الأحد ... 5 = الخميس
  period      Int // رقم الحصة

  @@unique([classId, weekday, period])
  @@index([schoolId])
}

// أعذار الغياب: تُقدَّم لطالب في تاريخ محدد، وتُعتمد أو تُرفض.
model Excuse {
  id        String       @id @default(cuid())
  schoolId  String
  studentId String
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime     @db.Date
  reason    String
  status    ExcuseStatus @default(PENDING)
  createdBy String?
  createdAt DateTime     @default(now())

  @@index([schoolId, date])
}

enum ExcuseStatus {
  PENDING
  APPROVED
  REJECTED
}

// رسائل المدرسة إلى ولي أمر طالب محدد.
model Message {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  senderId  String
  body      String
  createdAt DateTime @default(now())

  @@index([schoolId, studentId])
}

// إحالة طالب إلى الوكيل أو الموجه، وتُغلق بعد توثيق الإجراء المتخذ.
model Referral {
  id        String         @id @default(cuid())
  schoolId  String
  studentId String
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reason    String
  action    String?
  status    ReferralStatus @default(OPEN)
  createdBy String?
  createdAt DateTime       @default(now())
  closedAt  DateTime?

  @@index([schoolId, status])
}

enum ReferralStatus {
  OPEN
  CLOSED
}
