// المرحلة الأولى: المدارس والمستخدمون والأدوار.
// مبدأ عام: كل سجل تابع لمدرسة (schoolId) لعزل بيانات كل مدرسة عن غيرها.
// البيانات الشخصية محدودة بما يلزم فقط (تقليل البيانات)، ولا تُخزَّن كلمات المرور إلا مُجزّأة.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PRINCIPAL // مدير المدرسة
  STUDENT_AFFAIRS // وكيل شؤون الطلاب
  GUIDANCE // الموجّه الطلابي
  ACADEMIC_DEPUTY // وكيل الشؤون التعليمية
  TEACHER // المعلم
  GUARDIAN // ولي الأمر
}

model School {
  id                String        @id @default(cuid())
  name              String
  ministryNumber    String?
  region            String?
  city              String?
  stages            String[]      @default([])
  schoolType        String?       // بنين | بنات
  planType          String?       // عام | تحفيظ
  academicYear      String?
  currentTerm       String?
  compensationPoints Int          @default(80)
  createdAt         DateTime      @default(now())
  users     User[]
  classes   SchoolClass[]
  students  Student[]
}

model User {
  id                 String                @id @default(cuid())
  schoolId           String
  school             School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email              String                @unique
  nationalId         String?               @unique
  leaves             LeaveRequest[]
  duties             DutyAssignment[]
  circularReads      CircularRead[]
  invigilations      ExamInvigilation[]
  weeklyPlans        WeeklyPlan[]
  classVisits        ClassVisit[]
  staffAttendance    StaffAttendance[]
  committeeMembers   ExamCommitteeMember[]
  fullName           String
  passwordHash       String
  role               Role
  extraRoles         Role[]                @default([])
  isActive           Boolean               @default(true)
  mustChangePassword Boolean               @default(false)
  phone              String?
  specialty          String?
  createdAt          DateTime              @default(now())
  lastLoginAt        DateTime?

  @@index([schoolId])
}

// سجل التدقيق: من فعل ماذا ومتى، لحماية البيانات الشخصية وتتبّع الوصول.
model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  actorId   String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
}

// المرحلة الثانية: الفصول والطلاب والمواظبة والسلوك والجدول.
// كل جدول يحمل schoolId لعزل البيانات. بيانات الطالب محدودة بما يلزم فقط.

model SchoolClass {
  id               String           @id @default(cuid())
  schoolId         String
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name             String // مثال: أول ثانوي / 1
  students         Student[]
  periods          TimetableEntry[]
  examSlots        ExamSlot[]
  homeroomLeaderId String?
  counselorId      String? // الموجه الطلابي المسؤول عن الصف (مستخدم من المدرسة نفسها)

  @@unique([schoolId, name])
}

model Student {
  id            String           @id @default(cuid())
  schoolId      String
  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId       String?
  schoolClass   SchoolClass?     @relation(fields: [classId], references: [id], onDelete: SetNull)
  fullName      String
  nationalRef   String? // مرجع داخلي اختياري، لا يُخزَّن رقم الهوية الوطنية
  guardianId    String? // ولي الأمر (مستخدم بدور GUARDIAN)
  guardianName  String?
  guardianPhone String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  attendance    Attendance[]
  behaviors     BehaviorRecord[]
  excuses       Excuse[]
  messages      Message[]
  referrals     Referral[]
  pointsAwards  PointsAward[]
  learningCases LearningCase[]
  leaveRequests LeaveRequest[]

  @@index([schoolId])
}

model Attendance {
  id         String           @id @default(cuid())
  schoolId   String
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  recordedBy String?
  createdAt  DateTime         @default(now())

  @@unique([studentId, date])
  @@index([schoolId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model BehaviorRecord {
  id          String   @id @default(cuid())
  schoolId    String
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category    String // مخالفة / سلوك إيجابي / إجراء تربوي
  description String
  recordedBy  String?
  createdAt   DateTime @default(now())

  @@index([schoolId, studentId])
}

model TimetableSettings {
  id        String   @id @default(cuid())
  schoolId  String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model TimetableEntry {
  id          String      @id @default(cuid())
  schoolId    String
  classId     String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId   String? // مستخدم بدور TEACHER
  teacherName String? // اسم المعلم عندما لا يملك حسابًا بعد
  subject     String
  weekday     Int // 1 = الأحد ... 5 = الخميس
  period      Int // رقم الحصة

  @@unique([classId, weekday, period])
  @@index([schoolId])
}

// أعذار الغياب: تُقدَّم لطالب في تاريخ محدد، وتُعتمد أو تُرفض.
model Excuse {
  id        String       @id @default(cuid())
  schoolId  String
  studentId String
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime     @db.Date
  reason    String
  status    ExcuseStatus @default(PENDING)
  createdBy String?
  createdAt DateTime     @default(now())

  @@index([schoolId, date])
}

enum ExcuseStatus {
  PENDING
  APPROVED
  REJECTED
}

// رسائل المدرسة إلى ولي أمر طالب محدد.
model Message {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  senderId  String
  body      String
  createdAt DateTime @default(now())

  @@index([schoolId, studentId])
}

// إحالة طالب إلى الوكيل أو الموجه، وتُغلق بعد توثيق الإجراء المتخذ.
model Referral {
  id        String         @id @default(cuid())
  schoolId  String
  studentId String
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reason    String
  action    String?
  status    ReferralStatus @default(OPEN)
  createdBy String?
  createdAt DateTime       @default(now())
  closedAt  DateTime?

  @@index([schoolId, status])
}

enum ReferralStatus {
  OPEN
  CLOSED
}

// طلب استئذان معلم: يوم وساعة الخروج والعودة، ويُعتمد أو يُرفض، ويُسجَّل تأمين حصصه.
model LeaveRequest {
  id        String      @id @default(cuid())
  schoolId  String
  teacherId String
  teacher   User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date      DateTime    @db.Date
  leaveAt   String
  returnAt  String
  reason    String
  coverage  String?
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now())
  student   Student?    @relation(fields: [studentId], references: [id])
  studentId String?

  @@index([schoolId, date])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// تعيين معلم للإشراف على الفسحة أو المناوبة في يوم محدد.
model DutyAssignment {
  id        String   @id @default(cuid())
  schoolId  String
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  kind      String // "BREAK" للإشراف على الفسحة أو "DUTY" للمناوبة
  createdAt DateTime @default(now())

  @@unique([teacherId, date, kind])
  @@index([schoolId, date])
}

// تكليف معلم بحصة انتظار لفصل في يوم وحصة محددة، بدلًا من معلم غائب.
model Substitution {
  id           String   @id @default(cuid())
  schoolId     String
  date         DateTime @db.Date
  weekday      Int
  period       Int
  classId      String
  subject      String
  absentName   String
  substituteId String
  createdAt    DateTime @default(now())

  @@unique([classId, date, period])
  @@index([schoolId, date])
}

// تعميم تنشره الإدارة ويطّلع عليه المعنيون.
model Circular {
  id        String         @id @default(cuid())
  schoolId  String
  title     String
  body      String
  audience  String // "ALL" للجميع، "TEACHERS" للمعلمين فقط
  createdBy String?
  createdAt DateTime       @default(now())
  reads     CircularRead[]

  @@index([schoolId, createdAt])
}

// سجل الاطلاع على التعميم: من اطّلع ومتى.
model CircularRead {
  id         String   @id @default(cuid())
  circularId String
  circular   Circular @relation(fields: [circularId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt     DateTime @default(now())

  @@unique([circularId, userId])
}

// حصة اختبار: مادة فصل في يوم وحصة محددة.
model ExamSlot {
  id          String      @id @default(cuid())
  schoolId    String
  date        DateTime    @db.Date
  period      Int
  classId     String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     String
  createdAt   DateTime    @default(now())

  @@unique([classId, date, period])
  @@index([schoolId, date])
}

// تعيين معلم ملاحظًا لقاعة في يوم اختبار وحصة محددة.
model ExamInvigilation {
  id        String   @id @default(cuid())
  schoolId  String
  date      DateTime @db.Date
  period    Int
  room      String
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([date, period, room])
  @@index([schoolId, date])
}

// خطة نشاط مدرسي: صفي أو غير صفي أو إذاعة أو زيارة، تُعتمد لتظهر للمعلمين.
model ActivityPlan {
  id        String   @id @default(cuid())
  schoolId  String
  kind      String // "CLASS" صفي، "NON_CLASS" غير صفي، "BROADCAST" إذاعة، "VISIT" زيارة
  title     String
  date      DateTime @db.Date
  approved  Boolean  @default(false)
  createdBy String?
  createdAt DateTime @default(now())

  @@index([schoolId, date])
}

// الخطة الأسبوعية للمعلم: يرفعها كل معلم عن أسبوعه.
model WeeklyPlan {
  id        String   @id @default(cuid())
  schoolId  String
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date
  content   String
  planType  String   @default("CLASS") // CLASS | NON_CLASS | ACTIVITY
  createdAt DateTime @default(now())

  @@unique([teacherId, weekStart])
  @@index([schoolId, weekStart])
}

// لجنة اختبار: مثل لجنة الاختبارات أو لجنة المحضر، ولها أعضاء من المعلمين.
model ExamCommittee {
  id        String                @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime              @default(now())
  members   ExamCommitteeMember[]

  @@index([schoolId])
}

model ExamCommitteeMember {
  id          String        @id @default(cuid())
  committeeId String
  committee   ExamCommittee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  role        String // "رئيس" أو "عضو" أو "مراقب"

  @@unique([committeeId, teacherId])
}

// حالة صعوبات تعلم أو نطق: تُسجَّل للطالب وتُتابع حتى تُغلق.
model LearningCase {
  id          String   @id @default(cuid())
  schoolId    String
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind        String // "LEARNING" صعوبات تعلم، "SPEECH" صعوبات نطق
  description String
  open        Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([schoolId, kind])
}

// تسجيل أن حصة فصل في يوم معيّن قد حُضِّرت، ومن حضّرها.
model PeriodCheck {
  id         String   @id @default(cuid())
  schoolId   String
  classId    String
  date       DateTime @db.Date
  period     Int
  recordedBy String
  createdAt  DateTime @default(now())

  @@unique([classId, date, period])
  @@index([schoolId, date])
}

// نقاط إيجابية يُمنحها الطالب مع السبب، ويراها ولي الأمر لاحقًا.
model PointsAward {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  points    Int
  reason    String
  createdBy String?
  createdAt DateTime @default(now())

  @@index([schoolId, studentId])
}

// حضور المعلم والإداري: تأخر أو خروج مبكر أو غياب، مع المدة بالدقائق.
model StaffAttendance {
  id        String   @id @default(cuid())
  schoolId  String
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  kind      String // "LATE" تأخر، "EARLY_LEAVE" خروج مبكر، "ABSENT" غياب
  minutes   Int      @default(0)
  note      String?
  createdAt DateTime @default(now())

  @@index([schoolId, date])
}

// تقرير المناوبة اليومي: ملاحظات يوم المناوبة في نموذج واحد.
model DutyReport {
  id        String   @id @default(cuid())
  schoolId  String
  date      DateTime @db.Date
  notes     String
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([schoolId, date])
}

// تقرير نشاط طلابي: نص التنفيذ والشواهد، يقيّمه الإدارة.
model ActivityReport {
  id        String   @id @default(cuid())
  schoolId  String
  title     String
  body      String
  evidence  String?
  activityId String?
  witnesses  String? // شاهدان اثنان، كل اسم في سطر
  createdBy String?
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
}

// زيارة صفية: يطلبها المعلم أو الوكيل، ويعتمدها الوكيل بموعد.
model ClassVisit {
  id          String   @id @default(cuid())
  schoolId    String
  visitorName String
  teacherId   String?
  teacher     User?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  date        DateTime @db.Date
  period      Int
  className   String
  note        String?
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([schoolId, date])
}
